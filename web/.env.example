# Salin file ini menjadi .env (atau .env.local) lalu isi nilainya. Jangan commit file .env.

# PostgreSQL 15+ berisi datamart (schema mart) dan riwayat chat (schema app).
# Lokal:      postgresql://<user>@localhost:5432/jernih
# Production: Supabase Transaction pooler (port 6543) + ?sslmode=require, lihat README
# Penyedia LLM untuk Tanya Data: openai | deepseek
LLM_PROVIDER=openai

# Opsional. Kosongkan agar model memakai suhu default (disarankan untuk model reasoning
# yang menolak parameter temperature). Isi 0 untuk jawaban paling konsisten bila model mendukung.
LLM_TEMPERATURE=

# Opsional. Kosong = otomatis "none" untuk seri gpt-5.x (wajib agar tool diterima), dan tidak dikirim untuk model lain.
LLM_REASONING_EFFORT=

# --- OpenAI ---
OPENAI_API_KEY=
# ID model persis seperti di daftar model akun (huruf kecil, TANPA awalan "openai.").
# Contoh: OPENAI_MODEL=gpt-5.6-terra (bersama LLM_REASONING_EFFORT=none)
# Syarat: model mendukung Chat Completions + function/tool calling.
OPENAI_MODEL=openai.gpt-5.6-terra
# Opsional: gateway/proxy kompatibel OpenAI. Kosongkan untuk API resmi.
OPENAI_BASE_URL=

# --- DeepSeek (API kompatibel OpenAI) ---
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
