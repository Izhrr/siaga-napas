# Salin file ini menjadi .env (atau .env.local) lalu isi nilainya. Jangan commit file .env.

# PostgreSQL 15+ berisi datamart (schema mart) dan riwayat chat (schema app).
# Lokal:      postgresql://<user>@localhost:5432/jernih
# Production: connection string Neon / Supabase (pakai sslmode=require)
DATABASE_URL=

# Penyedia LLM untuk Tanya Data: openai | deepseek
LLM_PROVIDER=openai

# OpenAI: isi model chat yang mendukung tool calling di akun Anda
OPENAI_API_KEY=
OPENAI_MODEL=

# DeepSeek (API kompatibel OpenAI)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
